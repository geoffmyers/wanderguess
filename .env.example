# Example configuration. Copy to .env and fill in your own values (both the app
# and scripts/build-location-pool.mjs read .env).
# Angle-bracket values are placeholders; replace them.
# Wanderguess environment template.
#
# Mapillary client token. This is a PUBLIC token by design - it ships in the
# browser bundle, exactly as MapillaryJS does.
# Create one at https://www.mapillary.com/dashboard/developers
NEXT_PUBLIC_MAPILLARY_TOKEN=<your-client-token>

# Server-side token used only by scripts/build-location-pool.mjs. May be the
# same value as above.
MAPILLARY_TOKEN=<your-client-token>

# Contact address sent in the User-Agent for Nominatim reverse geocoding, as
# their usage policy requires. Also sent to the Wikidata query service by
# scripts/build-landmark-index.mjs, which asks for the same courtesy.
# Build-time only.
NOMINATIM_CONTACT=<your-nominatim-contact>
